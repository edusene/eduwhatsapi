# ==========================================================================
# EXEMPLO de configuração. Copie para `.env` e preencha com valores reais.
# NUNCA versione o arquivo `.env`. Todos os valores abaixo são FICTÍCIOS.
# ==========================================================================

# --- Aplicação Flask -------------------------------------------------------
# development | production
FLASK_ENV=development
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria-de-64-caracteres
# URL pública da aplicação (sem barra final). Usada em links de e-mail e webhooks.
APP_BASE_URL=http://localhost:5000
APP_NAME=AutoZap
# E-mail de suporte exibido no rodapé (opcional)
SUPPORT_EMAIL=
LOG_LEVEL=INFO
# true em produção (HTTPS); false só em desenvolvimento local
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_HOURS=12
# Limite do corpo das requisições em bytes (16 MB, por causa do upload de mídia)
MAX_CONTENT_LENGTH=16777216

# --- Supabase --------------------------------------------------------------
# Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (anon). Usada só pelo backend nos fluxos de autenticação.
SUPABASE_ANON_KEY=cole-aqui-a-anon-key
# Chave privilegiada. SOMENTE no backend. NUNCA no navegador nem no Git.
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key

# --- Meta / Facebook for Developers ----------------------------------------
# developers.facebook.com > seu app > Configurações do app > Básico
META_APP_ID=
META_APP_SECRET=
# Confira a versão atual em https://developers.facebook.com/docs/graph-api/changelog/
META_GRAPH_API_VERSION=v26.0
# ID da configuração do Embedded Signup (Facebook Login for Business > Configurações).
# Deixe vazio enquanto o app não for Tech Provider: o botão fica desativado.
META_ES_CONFIG_ID=
# Token que VOCÊ define e cola no painel da Meta ao configurar o webhook.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
META_WEBHOOK_VERIFY_TOKEN=
# Segredo usado para validar X-Hub-Signature-256. Se vazio, usa META_APP_SECRET.
META_WEBHOOK_APP_SECRET=
# Timeout (s) das chamadas à Graph API
META_HTTP_TIMEOUT=20

# --- Criptografia e hashing ------------------------------------------------
# Chave Fernet para criptografar tokens da Meta e segredos de webhook no banco.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ATENÇÃO: trocar esta chave torna ilegíveis os tokens já salvos (ver docs/security.md).
TOKEN_ENCRYPTION_KEY=
# Pepper do hash das chaves de API e convites. Trocar invalida todas as chaves.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY_PEPPER=

# --- Páginas legais ----------------------------------------------------------
# Se vazias, usam APP_BASE_URL/termos e APP_BASE_URL/privacidade.
LEGAL_TERMS_URL=
LEGAL_PRIVACY_URL=

# --- Rede e limites ----------------------------------------------------------
# Origens permitidas para CORS na API pública (separadas por vírgula). Vazio = nenhuma.
CORS_ORIGINS=
# memory:// funciona com 1 instância. Com várias instâncias use Redis: redis://host:6379/0
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_DEFAULT=300 per minute
API_RATE_LIMIT_PER_KEY=120 per minute

# --- Webhooks de saída e tarefas em segundo plano ---------------------------
OUTBOUND_WEBHOOK_TIMEOUT=10
OUTBOUND_WEBHOOK_MAX_ATTEMPTS=6
# Permite http:// e endereços locais nos webhooks de saída. SOMENTE desenvolvimento.
OUTBOUND_WEBHOOK_ALLOW_INSECURE=false
# Thread interna que reprocessa retries (padrão: ligada em produção)
BACKGROUND_WORKER_ENABLED=
BACKGROUND_WORKER_INTERVAL=30
# Segredo para /internal/cron/* (agendador externo). Vazio = endpoints desativados.
CRON_SECRET=
# Retenção (dias) dos logs de requisições
LOG_RETENTION_DAYS=90
# Confia em 1 proxy reverso (X-Forwarded-For/Proto). Padrão: ligado em produção.
TRUST_PROXY=
