# ==========================================================================
# EXEMPLO de configuração. Copie para `.env` e preencha com valores reais.
# NUNCA versione o arquivo `.env`. Todos os valores abaixo são FICTÍCIOS.
# ==========================================================================

# --- Aplicação Flask -------------------------------------------------------
# development | production | testing
FLASK_ENV=development
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria-de-64-caracteres
# URL pública base da aplicação (sem barra final). Usada em callbacks/webhooks.
APP_BASE_URL=http://localhost:5000
# Nível de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# true em produção (HTTPS obrigatório); false apenas em desenvolvimento local
SESSION_COOKIE_SECURE=false
# Limite de corpo de requisição em bytes (padrão 1 MB)
MAX_CONTENT_LENGTH=1048576

# --- Supabase --------------------------------------------------------------
# Encontradas em: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://qbydncuihpxcvzqzdtcu.supabase.co
# Chave pública (anon/publishable). Uso restrito; dados sensíveis passam pelo backend.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFieWRuY3VpaHB4Y3Z6cXpkdGN1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTE1OTIwOTMsImV4cCI6MjEwNzE2ODA5M30.dH0eMNv34SvpRnMsiQESu9FWFvBjScLIMtMFph9T00U
# Chave privilegiada. SOMENTE no backend. NUNCA expor ao navegador nem commitar.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFieWRuY3VpaHB4Y3Z6cXpkdGN1Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MTU5MjA5MywiZXhwIjoyMTA3MTY4MDkzfQ.tTCb3Xjvx2JDN62u51maezR_hbBG8a0yw2xRXWdRM_4

# --- Meta / Facebook for Developers ----------------------------------------
# developers.facebook.com > seu app > Configurações > Básico
META_APP_ID=1234567890123456
META_APP_SECRET=exemplo_app_secret_substitua
# Versão da Graph API. Confira a atual em:
# https://developers.facebook.com/docs/graph-api/changelog/
META_GRAPH_API_VERSION=v26.0
# URL de callback OAuth registrada no app da Meta. Em produção, HTTPS.
META_REDIRECT_URI=http://localhost:5000/connect/meta/callback
# Token de verificação do webhook (você define; use valor aleatório longo).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
META_WEBHOOK_VERIFY_TOKEN=exemplo_verify_token_substitua
# Segredo usado para validar X-Hub-Signature-256. Normalmente é o App Secret
# do app que assina os webhooks (WhatsApp > Configuração > App Secret).
META_WEBHOOK_APP_SECRET=exemplo_webhook_app_secret_substitua

# --- Criptografia e hashing internos ---------------------------------------
# Chave Fernet para criptografar tokens da Meta no banco.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=exemplo_fernet_key_substitua_base64_44_chars=
# Pepper (segredo do servidor) para o hash HMAC das chaves internas de API.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY_PEPPER=exemplo_pepper_substitua_64_caracteres_hex

# --- Rede / limites ---------------------------------------------------------
# Origens permitidas para CORS na API pública, separadas por vírgula.
CORS_ORIGINS=http://localhost:5000
# Armazenamento do rate limiter. memory:// para MVP; redis://host:6379/0 em produção.
RATE_LIMIT_STORAGE_URI=memory://

# --- Webhooks de saída ------------------------------------------------------
# Timeout (segundos) e tentativas máximas de entrega para webhooks de clientes.
OUTBOUND_WEBHOOK_TIMEOUT=10
OUTBOUND_WEBHOOK_MAX_ATTEMPTS=5
# Permite URLs http:// e hosts locais nos webhooks de saída (SOMENTE desenvolvimento).
OUTBOUND_WEBHOOK_ALLOW_INSECURE=false
